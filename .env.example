# ==========================================
# ALTER Platform Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & JWT
JWT_SECRET=alter_super_secret_jwt_key_2026_academic_orchestrator
JWT_EXPIRES_IN=7d

# Database (PostgreSQL with pgvector)
# Example: postgresql://postgres:postgres@localhost:5432/alter_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alter_db?schema=public

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI & LLM Providers (Optional for local mode / Fallback provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# File Ingestion & Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# External Integrations (Phases 3-5)
DEVPOST_API_KEY=
NOTION_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
